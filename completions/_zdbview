#compdef zdbview

# zsh completion for zdbview — terminal inspector / CRUD editor for rkyv
# archives and SQLite databases. Install by putting this file (named
# `_zdbview`) in a directory on $fpath, e.g.:
#   fpath=(/path/to/zdbview/completions $fpath)

_zdbview() {
    local -a args
    args=(
        '(--sqlite --rkyv)--sqlite[Force treating the file as a SQLite database]'
        '(--sqlite --rkyv)--rkyv[Force treating the file as a rkyv archive or raw binary]'
        '(--memory)--new[Create an empty database and open it]:new database:_files'
        '(--new)--memory[Open a database that lives only in memory]'
        '--readonly[Open read-only: every edit is refused]'
        '*--load-extension[Load a SQLite extension before opening]:extension:_files -g "*.(so|dylib|dll)(-.)"'
        '--project[Open the database a project names, with its settings]:project:_files'
        '--export[Non-interactively dump contents and exit]:format:(json csv tsv markdown insert line sql)'
        '--table[Restrict --export or --import to one table]:table:'
        '--backup[Copy the database with VACUUM INTO and exit]:destination:_files'
        '--import[Load a CSV or TSV into --table and exit]:csv file:_files -g "*.(csv|tsv|tab)(-.)"'
        '--import-sql[Run a file of SQL into the database and exit]:sql file:_files -g "*.sql(-.)"'
        '--recover[Salvage rows page by page to stdout as SQL, and exit]'
        '--theme[Color scheme for this run]:scheme:_zdbview_themes'
        '(- *)--list-themes[Preview all color schemes and exit]'
        '(--no-scan)*--scan[Scan DIR instead of the default roots]:directory:_files -/'
        '(--scan --rescan)--no-scan[Skip the scan; list only recent files]'
        '(--no-scan)--rescan[Walk again now, ignoring the saved scan]'
        '(- *)'{-h,--help}'[Print help]'
        '(- *)'{-V,--version}'[Print version]'
        '1:file:_zdbview_files'
    )
    _arguments -s -S : $args
}

# Scheme tokens come from the binary itself (--list-themes), so this never goes
# stale when schemes are added or renamed.
_zdbview_themes() {
    local -a schemes
    schemes=(${(f)"$(command zdbview --list-themes 2>/dev/null |
        command perl -lne 's/\e\[[0-9;]*m//g; print $1 if /^\s{2}(\w+)\s{2,}/')"})
    if (( ${#schemes} )); then
        _describe -t schemes 'color scheme' schemes
    else
        _message 'color scheme'
    fi
}

# Database-ish files first, then any file — a rkyv shard can carry any name.
_zdbview_files() {
    _alternative \
        'databases:database file:_files -g "*.(db|sqlite|sqlite3|rkyv|bin|cache)(-.)"' \
        'files:file:_files'
}

_zdbview "$@"
